[Unit]
Description=LearnCoding nightly restic backup to Cloudflare R2
Documentation=file:/opt/learncoding/docs/runbooks/backups-r2.md
After=learncoding-compose.service network-online.target
Wants=learncoding-compose.service network-online.target
RequiresMountsFor=/srv/learncoding
OnFailure=learncoding-alert@%n.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/bash /opt/learncoding/scripts/backup/restic-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0077
TimeoutStartSec=3h
