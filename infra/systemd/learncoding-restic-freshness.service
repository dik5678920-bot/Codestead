[Unit]
Description=Check LearnCoding restic backup and restore-test freshness
Documentation=/opt/learncoding/docs/runbooks/backups-r2.md
OnFailure=learncoding-alert@%n.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/bash /opt/learncoding/scripts/backup/restic-freshness.sh
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0077
TimeoutStartSec=10min
