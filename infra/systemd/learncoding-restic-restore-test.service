[Unit]
Description=LearnCoding monthly restic restore test into a throwaway PostgreSQL
Documentation=/opt/learncoding/docs/runbooks/backups-r2.md
After=network-online.target docker.service
Wants=network-online.target
OnFailure=learncoding-alert@%n.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/bash /opt/learncoding/scripts/backup/restic-restore-test.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=0077
TimeoutStartSec=2h
